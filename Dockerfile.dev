FROM mcr.microsoft.com/dotnet/sdk:8.0-bookworm-slim
LABEL org.opencontainers.image.source=https://github.com/cocorobotics/coco-interview-device-status

ARG NODE_VERSION=24.21.0
ARG GO_VERSION=1.26.0
ARG JUNIT_VERSION=1.11.4
ARG AMQP_JAVA_VERSION=5.22.0
ARG SLF4J_VERSION=2.0.16
ARG AMQP_GO_VERSION=v1.15.0
ARG GSON_VERSION=2.14.0
ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git xz-utils jq make procps psmisc lsof \
      vim nano less tree \
      python3 python3-pip python3-venv python3-pytest python3-pika \
      openjdk-17-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

RUN case "$TARGETARCH" in \
      arm64) NODE_ARCH=arm64; GO_ARCH=arm64 ;; \
      amd64) NODE_ARCH=x64;   GO_ARCH=amd64 ;; \
      *) echo "unsupported arch: $TARGETARCH" >&2; exit 1 ;; \
    esac \
 && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1 \
 && curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${GO_ARCH}.tar.gz" \
      | tar -xz -C /usr/local

RUN npm install -g typescript@5 && npm cache clean --force

RUN curl -fsSL -o /opt/junit-console.jar \
      "https://repo1.maven.org/maven2/org/junit/platform/junit-platform-console-standalone/${JUNIT_VERSION}/junit-platform-console-standalone-${JUNIT_VERSION}.jar" \
 && curl -fsSL -o /opt/gson.jar \
      "https://repo1.maven.org/maven2/com/google/code/gson/gson/${GSON_VERSION}/gson-${GSON_VERSION}.jar" \
 && curl -fsSL -o /opt/amqp-client.jar \
      "https://repo1.maven.org/maven2/com/rabbitmq/amqp-client/${AMQP_JAVA_VERSION}/amqp-client-${AMQP_JAVA_VERSION}.jar" \
 && curl -fsSL -o /opt/slf4j-api.jar \
      "https://repo1.maven.org/maven2/org/slf4j/slf4j-api/${SLF4J_VERSION}/slf4j-api-${SLF4J_VERSION}.jar" \
 && curl -fsSL -o /opt/slf4j-simple.jar \
      "https://repo1.maven.org/maven2/org/slf4j/slf4j-simple/${SLF4J_VERSION}/slf4j-simple-${SLF4J_VERSION}.jar"

# Warm the per-language package caches so a candidate never waits on a download.
RUN mkdir -p /tmp/warmgo && cd /tmp/warmgo && /usr/local/go/bin/go mod init warm >/dev/null \
 && /usr/local/go/bin/go get github.com/rabbitmq/amqp091-go@${AMQP_GO_VERSION} >/dev/null \
 && cd / && rm -rf /tmp/warmgo

RUN npm cache add amqplib@0.10.4 >/dev/null

RUN mkdir -p /tmp/warmcs && cd /tmp/warmcs && dotnet new console -o . >/dev/null 2>&1 \
 && dotnet add package RabbitMQ.Client --version 6.8.1 >/dev/null 2>&1 \
 && cd / && rm -rf /tmp/warmcs

RUN printf 'export PATH=/usr/local/go/bin:/root/go/bin:$PATH\n' > /etc/profile.d/toolchains.sh

ENV JUNIT_JAR=/opt/junit-console.jar \
    GSON_JAR=/opt/gson.jar \
    AMQP_JAR=/opt/amqp-client.jar \
    SLF4J_JARS=/opt/slf4j-api.jar:/opt/slf4j-simple.jar \
    PATH="/usr/local/go/bin:/root/go/bin:${PATH}" \
    GOCACHE=/tmp/go-build \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /work
CMD ["sleep", "infinity"]
